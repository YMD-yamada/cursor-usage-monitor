{
  "name": "cursor-usage-monitor",
  "productName": "Usageboard",
  "version": "1.0.0",
  "private": true,
  "description": "Unofficial resident widget for Cursor Usage pools, billing guide, and dashboard deep-links",
  "license": "MIT",
  "author": "ymd",
  "homepage": "https://github.com/YMD-yamada/cursor-usage-monitor",
  "repository": {
    "type": "git",
    "url": "https://github.com/YMD-yamada/cursor-usage-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/YMD-yamada/cursor-usage-monitor/issues"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/start-desktop.mjs",
    "install:resident": "node scripts/install-resident.mjs",
    "uninstall:resident": "node scripts/uninstall-resident.mjs",
    "dev": "node scripts/dev-electron.mjs",
    "dev:web": "node scripts/dev.mjs",
    "build": "vite build",
    "server": "node --experimental-sqlite server/index.mjs",
    "desktop": "node scripts/start-desktop.mjs",
    "desktop:dev": "node scripts/dev-electron.mjs",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icons.ps1",
    "pack:win": "npm run build && npx --yes electron-builder --win nsis portable appx --x64 --arm64 --config electron-builder.yml",
    "pack:store": "npm run build && npx --yes electron-builder --win appx --x64 --arm64 --config electron-builder.yml",
    "smoke": "node scripts/smoke.mjs",
    "smoke:resident": "node scripts/smoke.mjs --check-resident",
    "postinstall": "node scripts/fix-rollup-wasm.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.62.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.62.2"
  }
}
